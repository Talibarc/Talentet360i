# Local mock mode needs no credentials. Copy to backend/.env.
LLM_PROVIDER=mock
# Company laptop only: set LLM_PROVIDER=luna and replace these placeholders.
LUNA_BASE_URL=
LUNA_API_KEY=
LUNA_MODEL=
# Optional API version override; blank uses the existing integration default.
LUNA_API_VERSION=
# Optional SQLite URL; blank uses backend/talent360i.db.
DATABASE_URL=

# Offline document ingestion. The defaults are safe local test paths.
RAG_SOURCE_DIR=backend/tests/fixtures/synthetic_rag
RAG_INDEX_DIR=backend/.rag_index
ALLOW_SYNTHETIC_RAG=true
RAG_MAX_FILE_BYTES=26214400
RAG_MAX_BATCH_FILES=20
RAG_MAX_BATCH_BYTES=104857600

# Office-laptop placeholders (replace only in the untracked local .env):
# LLM_PROVIDER=luna
# RAG_SOURCE_DIR=C:\Talent360i-Secure-Sources
# RAG_INDEX_DIR=C:\Talent360i-Local-Index
# ALLOW_SYNTHETIC_RAG=false
