# Local mock mode needs no credentials. Copy to backend/.env.
LLM_PROVIDER=mock
# Company laptop only: set LLM_PROVIDER=luna and replace these placeholders.
LUNA_BASE_URL=
LUNA_API_KEY=
LUNA_MODEL=
# Optional API version override; blank uses the existing integration default.
LUNA_API_VERSION=
# Optional SQLite URL; blank uses backend/talent360i.db.
DATABASE_URL=

